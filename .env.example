APP_NAME="DepoWork ITS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://its.depowork.com.tr

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-posta: app.depowork.com.tr "Mail Ayarları" ile aynı SMTP hesabı (Paydaş Değişimleri bildirimleri bununla gider).
# MAIL_PASSWORD canlı .env dosyasında elle girilir; depoya yazılmaz.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.clouddepo.com.tr
MAIL_PORT=465
MAIL_USERNAME=noreply@app.depowork.com.tr
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@app.depowork.com.tr"
MAIL_FROM_NAME="Depo Setup Entegre İş Yönetim Platformu"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ITS_DRIVER=mock
ITS_BASE_URL=https://itstest2.saglik.gov.tr
SUPPORT_WHATSAPP=
ITS_YAZMA=false
