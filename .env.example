APP_NAME="DepoWork İTS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Istanbul
APP_URL=https://its.depowork.com.tr
APP_LOCALE=tr

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=depoworkits
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=clouddepo.com.tr
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@depowork.com.tr"
MAIL_FROM_NAME="${APP_NAME}"

# İTS / İEGM entegrasyon servisi (REST API, resmi adres listesi: its.gov.tr)
ITS_API_BASE_URL=https://its2.saglik.gov.tr
ITS_API_TIMEOUT=30

# Lisans süresi bitmeden kaç gün önce hatırlatma maili gönderilsin
LICENSE_REMINDER_DAYS=30,14,7,1
